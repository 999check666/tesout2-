<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>8×8 Three-in-a-Row</title>

  <!-- Simple styles for the page and board -->
  <style>
    body { font-family: sans-serif; padding: 20px; max-width: 440px; margin: auto; }
    .board { display: grid; grid-template-columns: repeat(8, 40px); gap: 2px; background: #888; padding: 2px; width: fit-content; }
    .square { width: 40px; height: 40px; padding: 0; border: 1px solid #bbb; cursor: pointer; }
    .controls { margin-top: 12px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    pre { background: #f3f3f3; padding: 10px; border-radius: 6px; overflow-x: auto; }
  </style>

  <!-- Load React, ReactDOM, and Babel from CDNs (an internet connection is needed) -->
  <script src="https://unpkg.com/react@18.2.0/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18.2.0/umd/react-dom.development.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body>
  <!-- React will display the app inside this element -->
  <div id="root"></div>

  <!-- Babel converts this JSX into JavaScript the browser can run -->
  <script type="text/babel">
    // Make a fresh board: 0 = white, 1 = black, 2 = green
    const emptyGrid = () => Array.from({ length: 8 }, () => Array(8).fill(0));

    // Check for 3 matching squares in a horizontal, vertical, or diagonal line
    const hasThree = (board, player) => {
      const directions = [[0, 1], [1, 0], [1, 1], [1, -1]];
      for (let r = 0; r < 8; r++) {
        for (let c = 0; c < 8; c++) {
          for (const [dr, dc] of directions) {
            const r2 = r + 2 * dr;
            const c2 = c + 2 * dc;
            if (
              r2 >= 0 && r2 < 8 && c2 >= 0 && c2 < 8 &&
              board[r][c] === player &&
              board[r + dr][c + dc] === player &&
              board[r2][c2] === player
            ) return true;
          }
        }
      }
      return false;
    };

    // The app component stores the board and the game status
    function App() {
      const [grid, setGrid] = React.useState(emptyGrid());
      const [turn, setTurn] = React.useState(1);
      const [winner, setWinner] = React.useState(0);
      const [count, setCount] = React.useState(null);

      // Place the current player's color in an empty square and check for a win
      const play = (r, c) => {
        if (grid[r][c] !== 0 || winner) return;
        const copy = grid.map((row) => [...row]);
        copy[r][c] = turn;
        setGrid(copy);
        setCount(null);
        if (hasThree(copy, turn)) setWinner(turn);
        else if (copy.flat().every((square) => square !== 0)) setWinner(-1);
        else setTurn(turn === 1 ? 2 : 1);
      };

      // Count black squares currently on the board
      const countBlack = () => setCount(grid.flat().filter((square) => square === 1).length);

      // Reset the game and let Black start again
      const clear = () => {
        setGrid(emptyGrid());
        setTurn(1);
        setWinner(0);
        setCount(null);
      };

      // Format the board as a Python list of lists
      const pythonText = "[\n" + grid.map((row) => "  [" + row.join(", ") + "]").join(",\n") + "\n]";

      // Draw the game, buttons, winner message, and Python-style board
      return (
        <main>
          <h2>8×8 Three-in-a-Row</h2>
          <p aria-live="polite">
            {winner === 1 ? "Black wins!" : winner === 2 ? "Green wins!" : winner === -1 ? "It’s a draw!" : `Turn: ${turn === 1 ? "Black" : "Green"}`}
          </p>

          <div className="board">
            {grid.map((row, r) => row.map((value, c) => (
              <button
                key={`${r}-${c}`}
                className="square"
                aria-label={`Row ${r + 1}, column ${c + 1}: ${value === 0 ? "white" : value === 1 ? "black" : "green"}`}
                onClick={() => play(r, c)}
                style={{ background: value === 1 ? "black" : value === 2 ? "green" : "white", cursor: winner || value !== 0 ? "default" : "pointer" }}
              />
            )))}
          </div>

          <div className="controls">
            <button onClick={countBlack}>Count black pixels</button>
            <button onClick={clear}>Clear</button>
            {count !== null && <span>Black pixels: <b>{count}</b></span>}
          </div>

          <p>Grid values: 0 = white, 1 = black, 2 = green</p>
          <pre>{pythonText}</pre>
        </main>
      );
    }

    // Start React inside the root element above
    ReactDOM.createRoot(document.getElementById("root")).render(<App />);
  </script>
</body>
</html>
